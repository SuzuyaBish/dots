{
	"explorer.compactFolders": false,
	"workbench.startupEditor": "none",
	"biome.suggestInstallingGlobally": true,
	"workbench.productIconTheme": "icons-carbon",
	"editor.cursorBlinking": "smooth",
	"editor.fontSize": 14,
	"editor.fontFamily": "Lilex Nerd Font",
	"editor.lineHeight": 1.62,
	"editor.scrollbar.vertical": "hidden",
	"editor.scrollbar.horizontal": "hidden",
	"editor.overviewRulerBorder": false,
	"editor.hideCursorInOverviewRuler": true,
	"editor.selectionHighlight": false,
	"editor.bracketPairColorization.enabled": true,
	"breadcrumbs.enabled": false,
	"breadcrumbs.icons": false,
	"breadcrumbs.symbolPath": "off",
	"workbench.editor.showTabs": "multiple",
	"editor.lineNumbers": "relative",
	"editor.glyphMargin": false,
	"editor.folding": false,
	"editor.renderWhitespace": "none",
	"workbench.tree.indent": 24,
	"workbench.tree.renderIndentGuides": "always",
	"vscode-neovim.compositeKeys": {
		"kj": {
			"command": "vscode-neovim.escape",
			"args": []
		}
	},
	"[typescript][typescriptreact][json][javascript][javascriptreact]": {
		"editor.codeActionsOnSave": {
			"source.fixAll.biome": "always",
			"source.organizeImports.biome": "always"
		}
	},
	"editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file", 
	"workbench.iconTheme": "flow-deep",
	"git.postCommitCommand": "push",
	"workbench.activityBar.orientation": "vertical",
	"editor.tabSize": 2,
	"extensions.experimental.affinity": {
		"asvetliakov.vscode-neovim": 1
	},
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.js",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js",
		"*.tsx": "${capture}.ts",
		"tsconfig.json": "tsconfig.*.json",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
		"*.sqlite": "${capture}.${extname}-*",
		"*.db": "${capture}.${extname}-*",
		"*.sqlite3": "${capture}.${extname}-*",
		"*.db3": "${capture}.${extname}-*",
		"*.sdb": "${capture}.${extname}-*",
		"*.s3db": "${capture}.${extname}-*"
	},
	"typescript.updateImportsOnFileMove.enabled": "always",
	"workbench.colorTheme": "Kanso Zen",
	"javascript.updateImportsOnFileMove.enabled": "always"
}
